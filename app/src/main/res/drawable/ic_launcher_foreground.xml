<?xml version="1.0" encoding="utf-8"?>
<!-- Internet Radio's own launcher mark: a broadcast dot with three signal arcs and a sparkle,
     drawn in the same palette as the other apps in this project. Before this the app used
     Android's stock play icon, which is not something a store listing can ship. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- outer signal arc -->
    <path
        android:fillColor="#A78BFA"
        android:pathData="M21.11,52.03 A35,35 0 0 1 86.89,52.03 L81.25,54.08 A29,29 0 0 0 26.75,54.08 Z" />
    <!-- middle arc -->
    <path
        android:fillColor="#22D3EE"
        android:pathData="M29.57,55.11 A26,26 0 0 1 78.43,55.11 L72.79,57.16 A20,20 0 0 0 35.21,57.16 Z" />
    <!-- inner arc -->
    <path
        android:fillColor="#22D3EE"
        android:pathData="M38.03,58.19 A17,17 0 0 1 69.97,58.19 L64.34,60.24 A11,11 0 0 0 43.66,60.24 Z" />
    <!-- broadcast dot -->
    <path
        android:fillColor="#34D399"
        android:pathData="M54,58 A6,6 0 1 1 54,70 A6,6 0 1 1 54,58 Z" />
    <!-- sparkle -->
    <path
        android:fillColor="#FFD166"
        android:pathData="M30,75 L31.8,80.2 L37,82 L31.8,83.8 L30,89 L28.2,83.8 L23,82 L28.2,80.2 Z" />
</vector>
