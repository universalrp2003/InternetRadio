<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Full storage access: needed to scan and delete junk files, empty folders, duplicates. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!--
        Android 8, 9 and 10 (API 26-29) have no "All files access": deleting a scanned
        file there needs runtime WRITE_EXTERNAL_STORAGE. Without it the scan shows the
        junk, then deletion silently fails and the app reported "0 MB cleaned" - the bug
        users hit on phones like the Oppo A3s. From API 30 the All-files-access screen
        replaces it, so the permission is capped at 29.
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"
        tools:ignore="ScopedStorage" />

    <!-- Detect whether an APK file belongs to an already-installed app. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- AI analysis (optional, only used when you tap Analyse with your own key). -->
        <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Explicit verified in-app APK update only; Android permission and installer confirmation remain required. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Wi-Fi details + "who is on my network". Location is requested at runtime and is
         only used while the network screen is open. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- (ACCESS_NETWORK_STATE above is also what the Wi-Fi/mobile-data voice warning reads.) -->

    <!--
      Mobile & data screen: the operator, the SIM names, "5G or 4G" and the real signal in
      dBm need READ_PHONE_STATE on modern Android. Nothing is read outside that screen and
      nothing is sent anywhere. Location (already declared) is what unlocks cell-tower ids.
    -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />

    <!-- Ongoing charging card in the status bar (charging watts, %, time to full). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- v2.47: 4G/5G split counting. Local sampling only; no network transfer. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!--
      The "watt reading beside the clock" the user asked for: Android offers no API for a
      third-party status-bar item, so CleanSweep draws one tiny, touch-through overlay in
      the empty part of the status bar. Off by default; needs "Display over other apps".
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Battery / thermal / CPU readings need no permission at all: they come from the
         system battery broadcast and the kernel's own sysfs files. -->

    <!--
      Voice. Android 11+ hides other apps' activities unless the app says what it is looking
      for, so this one query is what lets the assistant's microphone button find the phone's
      own speech recogniser. No RECORD_AUDIO permission is requested and no audio is ever
      stored by CleanSweep: the recogniser returns text, which is exactly like typing it.
    -->
    <queries>
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
        <intent><action android:name="com.android.settings.TTS_SETTINGS" /></intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <!-- Read per-app cache sizes (special app permission, granted from Settings). -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.CleanSweep"
        android:localeConfig="@xml/locales_config">

        <activity
            android:name=".MainActivity"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            v1.3: no Accessibility service. CleanSweep never asks for the
            "Accessibility" permission and never automates taps in other apps.
            App caches are cleared through the guided two-tap flow instead.
        -->

        <!--
            The charging status card. It only runs while the charger is connected, shows
            watts / percentage / time to full, and stops itself when the cable comes out.
        -->
        <!--
            v2.47: the 4G/5G watch. Started only when the user turns on split counting or
            radio-change announcements; it samples the local byte counter every 3 seconds and
            listens for TelephonyDisplayInfo (the only reliable 5G signal on NSA networks).
        -->
        <service
            android:name=".notify.RadioWatchService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".notify.ChargeMonitorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Battery charging timer shown in the status bar while the phone charges" />
        </service>

        <!--
          Best-effort manifest power fallback. Android8+ may restrict/defer implicit delivery;
          AutomaticAlerts also owns runtime receivers while visible/existing monitoring runs.
          Visual monitoring is ignored while its switches are off.
        -->
        <receiver
            android:name=".notify.ChargingWatcher"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED" />
            </intent-filter>
        </receiver>

        <!--
          v2.4 instant warnings: Wi-Fi/mobile-data changes, an early unplug, and a charger that
          is connected but delivering nothing. Each one is behind its own switch and behind
          quiet hours; the user can turn every one of them off.
        -->
        <!--
            v2.40: no NotificationListenerService. Live Guard's core does not read other
            apps' notifications or messages and declares no
            BIND_NOTIFICATION_LISTENER_SERVICE capability, no SMS/Contacts/Call-log
            permission, no Accessibility service and no device-admin binding. The retired
            2.39 reader sources are archived under docs/archived-notification-reader-2.39
            and are NOT part of any Android source set.
        -->
        <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.updates.files"
            android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/liveguard_update_paths" />
        </provider>
        <!-- Compact battery, data and phone launcher choices. Floating pill is unchanged. -->
        <!-- Home-screen widget: battery, storage, the last daily brief, Clean and Read aloud. -->
        <receiver
            android:name=".widget.CleanSweepWidget"
            android:label="@string/widget_battery_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.universalrp.cleansweep.WIDGET_SPEAK" />
                <action android:name="com.universalrp.cleansweep.WIDGET_REFRESH" />
                <action android:name="com.universalrp.cleansweep.WIDGET_MODE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_cleansweep_info" />
        </receiver>

        <receiver android:name=".widget.CleanSweepDataWidget" android:exported="false" android:label="@string/widget_data_label">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_cleansweep_data_info" />
        </receiver>
        <receiver android:name=".widget.CleanSweepPhoneWidget" android:exported="false" android:label="@string/widget_phone_label">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_cleansweep_phone_info" />
        </receiver>

        <!-- v2.10: CONNECTIVITY_CHANGE was removed — Android 8+ never delivers it to
             manifest receivers, so the filter was dead. The Wi-Fi/mobile-data warning
             now runs in the hourly HealthWatchWorker pass instead. -->
        <receiver
            android:name=".notify.SystemEventWatcher"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED" />
            </intent-filter>
        </receiver>

        <!-- Auto-start receiver after phone reboot: restores persistent monitoring, widget, and hourly health checks -->
        <receiver
            android:name=".notify.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
