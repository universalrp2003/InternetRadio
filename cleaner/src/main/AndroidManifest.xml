<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Full storage access: needed to scan and delete junk files, empty folders, duplicates. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!--
        Android 8, 9 and 10 (API 26-29) have no "All files access": deleting a scanned
        file there needs runtime WRITE_EXTERNAL_STORAGE. Without it the scan shows the
        junk, then deletion silently fails and the app reported "0 MB cleaned" - the bug
        users hit on phones like the Oppo A3s. From API 30 the All-files-access screen
        replaces it, so the permission is capped at 29.
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"
        tools:ignore="ScopedStorage" />

    <!-- Detect whether an APK file belongs to an already-installed app. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- AI analysis (optional, only used when you tap Analyse with your own key). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Wi-Fi details + "who is on my network". Location is requested at runtime and is
         only used while the network screen is open. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!--
      Mobile & data screen: the operator, the SIM names, "5G or 4G" and the real signal in
      dBm need READ_PHONE_STATE on modern Android. Nothing is read outside that screen and
      nothing is sent anywhere. Location (already declared) is what unlocks cell-tower ids.
    -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />

    <!-- Ongoing charging card in the status bar (charging watts, %, time to full). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!--
      The "watt reading beside the clock" the user asked for: Android offers no API for a
      third-party status-bar item, so CleanSweep draws one tiny, touch-through overlay in
      the empty part of the status bar. Off by default; needs "Display over other apps".
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Battery / thermal / CPU readings need no permission at all: they come from the
         system battery broadcast and the kernel's own sysfs files. -->

    <!--
      Voice. Android 11+ hides other apps' activities unless the app says what it is looking
      for, so this one query is what lets the assistant's microphone button find the phone's
      own speech recogniser. No RECORD_AUDIO permission is requested and no audio is ever
      stored by CleanSweep: the recogniser returns text, which is exactly like typing it.
    -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <!-- Read per-app cache sizes (special app permission, granted from Settings). -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.CleanSweep"
        android:localeConfig="@xml/locales_config">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            v1.3: no Accessibility service. CleanSweep never asks for the
            "Accessibility" permission and never automates taps in other apps.
            App caches are cleared through the guided two-tap flow instead.
        -->

        <!--
            The charging status card. It only runs while the charger is connected, shows
            watts / percentage / time to full, and stops itself when the cable comes out.
        -->
        <service
            android:name=".notify.ChargeMonitorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Battery charging timer shown in the status bar while the phone charges" />
        </service>

        <!--
          Plug in the charger and the status-bar card / watt reading appear on their own —
          no need to open the app first. Ignored while both switches are off.
        -->
        <receiver
            android:name=".notify.ChargingWatcher"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
