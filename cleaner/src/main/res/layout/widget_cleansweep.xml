<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_liveguard_background" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="@string/app_name" android:textColor="#67E8F9" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_mode" android:layout_width="48dp" android:layout_height="48dp"
            android:gravity="center" android:text="% + W" android:textColor="#67E8F9" android:textSize="13sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <LinearLayout android:id="@+id/widget_battery_group" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/widget_battery_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#A9BBD1" android:textSize="12sp" />
            <TextView android:id="@+id/widget_battery" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="— %" android:textColor="#F8FAFC" android:textSize="28sp" android:textStyle="bold" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_power_group" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/widget_power_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#A9BBD1" android:textSize="12sp" />
            <TextView android:id="@+id/widget_power" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="— W" android:textColor="#67E8F9" android:textSize="25sp" android:textStyle="bold" android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
    <ProgressBar android:id="@+id/widget_charge_bar" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="5dp" android:max="100" android:progress="0"
        android:progressTint="#22D3EE" android:progressBackgroundTint="#26364B" />
    <TextView android:id="@+id/widget_state" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="#CBD5E1" android:textSize="11sp" />
    <TextView android:id="@+id/widget_sensors" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="#E2E8F0" android:textSize="12sp" />
    <TextView android:id="@+id/widget_data" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="#A5B4FC" android:textSize="11sp" />
    <TextView android:id="@+id/widget_storage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="#CBD5E1" android:textSize="11sp" />
    <TextView android:id="@+id/widget_brief" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:maxLines="2" android:ellipsize="end" android:textColor="#A9BBD1" android:textSize="11sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp">
        <TextView android:id="@+id/widget_clean" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
            android:gravity="center" android:background="#2438BDF8" android:text="@string/widget_clean" android:textColor="#7DD3FC" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_details" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
            android:gravity="center" android:textColor="#F8FAFC" android:textSize="12sp" />
        <TextView android:id="@+id/widget_refresh" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
            android:gravity="center" android:textColor="#67E8F9" android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
