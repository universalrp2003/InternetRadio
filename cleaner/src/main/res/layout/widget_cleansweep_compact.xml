<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_liveguard_background" android:padding="8dp">
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/app_name" android:textColor="#67E8F9" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_battery" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="— %" android:textColor="#F8FAFC" android:textSize="22sp" android:textStyle="bold" android:maxLines="1" />
        <TextView android:id="@+id/widget_state" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="8dp" android:textColor="#CBD5E1" android:textSize="10sp" android:maxLines="2" android:ellipsize="end" />
    </LinearLayout>
    <TextView android:id="@+id/widget_data" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="3dp" android:textColor="#E2E8F0" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/widget_brief" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:textColor="#A9BBD1" android:textSize="11sp" android:maxLines="2" android:ellipsize="end" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_mode" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:gravity="center" android:textColor="#67E8F9" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_details" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:gravity="center" android:textColor="#F8FAFC" android:textSize="12sp" />
        <TextView android:id="@+id/widget_refresh" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:gravity="center" android:textColor="#67E8F9" android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
